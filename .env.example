# FOG-IQ Environment Configuration

# Server & Networking
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Google Maps Platform Credentials
# Frontend Browser Key (restricted to http://localhost:5173 or domain)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY_HERE

# Backend Server Key (restricted to server IP for Routes & Places API)
GOOGLE_MAPS_SERVER_API_KEY=YOUR_GOOGLE_MAPS_SERVER_KEY_HERE

# AWS Cloud Integration (Set FOGIQ_AWS_ENABLED=true when AWS credentials exist)
FOGIQ_AWS_ENABLED=false
AWS_DEFAULT_REGION=ap-south-1
FOGIQ_S3_BUCKET=fog-iq-telemetry-datalake
FOGIQ_DYNAMO_TABLE=fog-iq-sensor-state
FOGIQ_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:fog-iq-critical-alerts

# Simulator Parameters
SIMULATOR_UPDATE_INTERVAL_SEC=1.8
CHENNAI_DEFAULT_LAT=13.0827
CHENNAI_DEFAULT_LNG=80.2707

